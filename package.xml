<?xml version="1.0"?>
<package format="3">
  <name>grasping_pipeline_msgs</name>
  <version>0.0.0</version>
  <description>The grasping_pipeline_msgs package</description>

  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 interface generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Message dependencies -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Action support (ROS 2 native) -->
  <depend>action_msgs</depend>

  <!-- Other message packages -->
  <depend>object_detector_msgs</depend>

  <!-- Required for interface-only packages -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
